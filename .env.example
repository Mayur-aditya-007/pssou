# ==============================================================================
# PSSOU Admission Lead Microsite (a.pssou.net) Environment Configuration
# ==============================================================================

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP Email Configuration (Nodemailer for 6-digit OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# If using Gmail SMTP, keep SMTP_FROM aligned with your SMTP_USER email
SMTP_FROM="PSSOU Admissions <your_email@gmail.com>"

# Meta WhatsApp Cloud API (Admissions Staff Notification)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NOTIFY_NUMBER=

# Analytics & Ad Tracking (Gated conditionally)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=

# Portal & Microsite URLs
NEXT_PUBLIC_PORTAL_REDIRECT_URL=https://pssou.net/portal/
NEXT_PUBLIC_SITE_URL=https://a.pssou.net
